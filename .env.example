# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed

# Sentry error tracking (optional)
# 1. Go to https://sentry.io → Your Project → Settings → Client Keys (DSN)
# 2. Regenerate your DSN (the old one was exposed in git history - MUST regenerate)
# 3. Paste the new DSN below
# 4. For production builds, also add this as an EAS secret:
#    eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value "your-new-dsn"
EXPO_PUBLIC_SENTRY_DSN=
