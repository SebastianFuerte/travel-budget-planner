# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed

# ─── Sentry (optional — error tracking) ──────────────────────────────────────
# 1. Go to https://sentry.io → Your Project → Settings → Client Keys (DSN)
# 2. Regenerate your DSN (old one was exposed — MUST regenerate)
# 3. For production: eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value "dsn"
EXPO_PUBLIC_SENTRY_DSN=

# ─── RevenueCat (REQUIRED for paid subscriptions) ────────────────────────────
# 1. Create account at https://app.revenuecat.com
# 2. Create a new Project → Add iOS App
# 3. Copy the PUBLIC API key (starts with appl_...)
# 4. In RevenueCat: Products → Add product IDs:
#      travel_budget_pro_monthly   ($4.99/month)
#      travel_budget_pro_annual    ($39.99/year)
# 5. In RevenueCat: Entitlements → Create "pro" entitlement → attach both products
# 6. In RevenueCat: Offerings → Create "default" offering → attach both packages
# 7. For production: eas secret:create --scope project --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value "appl_..."
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
